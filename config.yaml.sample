# Minimal bootstrap config for first startup.
# Most product and operational settings are now managed in the admin UI:
#   /#/admin/settings
#
# Loading behavior:
# - Built-in defaults are embedded in the binary
# - This file only overrides the bootstrap-critical parts
# - Ports / DB / Redis / feature selection stay file-based

App:
  RunMode: debug

Features:
  Default: ["Web", "Frontend:EmbedWeb", "Meili", "LocalOSS", "MySQL", "BigCacheIndex", "LoggerFile"]

WebServer:
  HttpIp: 0.0.0.0
  HttpPort: 8008

Database:
  LogLevel: error
  TablePrefix: p_

MySQL:
  Username: paopao
  Password: paopao
  Host: db:3306
  DBName: paopao
  Charset: utf8mb4
  ParseTime: true
  MaxIdleConns: 10
  MaxOpenConns: 30

Redis:
  InitAddress:
    - redis:6379

JWT:
  Secret: 18a6413dc4fe394c66345ebe501b2f26
  Issuer: paopao-api
  Expire: 86400

AdminSettings:
  EncryptionKey: "CHANGE-ME-TO-A-LONG-RANDOM-SECRET"

# Optional first-boot overrides for the providers enabled in Features.Default.
# If the embedded defaults already match your environment, you can remove these
# and manage later adjustments from /#/admin/settings.
Meili:
  Host: meili:7700
  Index: paopao-data
  ApiKey: paopao-meilisearch
  Secure: false

LocalOSS:
  SavePath: custom/data/paopao-ce/oss
  Secure: false
  Bucket: paopao
  Domain: 127.0.0.1:8008

# TelegramOSS:
#   Endpoint: "http://127.0.0.1:8081"
#   Token: "YOUR_TELEGRAM_BOT_TOKEN"
#   Proxy: ""
#   Domain: 127.0.0.1:8008
#   Secure: false
#   LocalMode: false
#   ChannelStrategy: "round-robin"
#   Channels:
#     - Id: "-1001234567890"
#       Name: "MainStorageA"
#       Weight: 10
#   Cache:
#     Enabled: true
#     SavePath: "custom/data/paopao-ce/tgcache"
#     MaxSizeMB: 4096
#     MaxAgeDays: 30

PT:
  AnnounceUrl: "http://127.0.0.1:8008/announce"
  WsAnnounceUrl: "ws://127.0.0.1:8008/tracker/ws"
  AnnounceInterval: 1800
  MinInterval: 300
  SiteSource: "[PaoPao] PaoPao PT"
  StoragePath: "custom/data/paopao-ce/torrents"
  Authority:
    PromotionInterval: 3600
    ClassNames:
      0: "贫民"
      1: "普通会员"
      2: "进阶用户"
      3: "精英用户"
      4: "疯狂用户"
      5: "疯魔用户"
      6: "骨灰用户"
      7: "极品用户"
      8: "巅峰用户"
      9: "大师用户"
      10: "VIP"
      11: "养老退役"
      12: "发布员"
      13: "版主"
      14: "管理员"
      15: "技术主管"
      16: "站长"
